{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "github>mendersoftware/mendertesting//renovate/common.json5"
  ],

  "baseBranchPatterns": ["master", "5.1.x", "5.2.x"],

  "packageRules": [
    // Go: one PR for all modules.
    {
      "matchManagers": ["gomod"],
      "groupName": "golang-dependencies",
      "groupSlug": "golang-dependencies"
    },

    // Docker base images: one grouped PR.
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker-base-images",
      "groupSlug": "docker-base-images"
    },
  ],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/tests/Dockerfile.daemon/"],
      "matchStrings": [
        "MENDER_ARTIFACT_VERSION=\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "mendersoftware/mender-artifact",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
  ],
}
